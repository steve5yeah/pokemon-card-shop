# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 값이 필요한지" 알려주는 예시입니다.
# 실제 값은 .env.local 에 적고, .env.local 은 깃허브에 올라가지 않습니다.
# Vercel 에도 아래 이름 그대로 넣습니다. (NEXT_PUBLIC_ 접두사 없음)
# 브라우저로 값을 넘기는 일은 next.config.ts 가 대신 해 줍니다.
# ─────────────────────────────────────────────────────────────

# Supabase (회원 · 데이터베이스 · 사진 보관)
# 쇼핑몰 전용 프로젝트입니다. 가계부/고구마마켓과 다른 프로젝트예요.
SUPABASE_URL=https://여기에_프로젝트_주소.supabase.co
SUPABASE_ANON_KEY=여기에_anon_키

# 사이트 주소 — 결제가 끝난 뒤 돌아올 주소를 만들 때 씁니다.
# 비워 두면 접속한 주소를 그대로 씁니다. (Vercel 에서는 배포 주소를 넣어 주세요)
SITE_URL=

# 토스페이먼츠 — 아래는 토스 공식 문서에 적혀 있는 "테스트용" 키입니다.
# 테스트 키로는 결제창이 뜨긴 하지만 실제로 돈이 빠져나가지 않습니다.
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# ⚠️ 아래 시크릿 키는 서버에서만 씁니다.
#    절대 next.config.ts 의 env 항목에 넣지 마세요. (브라우저에 노출됩니다)
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# Supabase 서버 전용 키 (service_role / Secret key)
# 결제 확정 때만 씁니다. 브라우저로 절대 나가면 안 됩니다.
# Supabase 대시보드 > Settings > API Keys 에서 복사하세요.
SUPABASE_SECRET_KEY=여기에_서버_전용_키
